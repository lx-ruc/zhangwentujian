{
  "name": "zhangwentujian",
  "version": "0.1.0",
  "private": true,
  "description": "掌纹测运 — AI 掌纹趣味测试微信小程序",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p cloudfunctions/tsconfig.json",
    "test": "jest",
    "e2e": "node e2e/smoke.js",
    "build:cloud": "tsc -p cloudfunctions/tsconfig.build.json",
    "deploy:cloud": "npm run build:cloud && /Applications/wechatwebdevtools.app/Contents/MacOS/cli cloud functions deploy --env cloud1-d9g41s8gza68b70b8 --names analyze --project . --remote-npm-install"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^18.19.0",
    "jest": "^29.7.0",
    "miniprogram-api-typings": "^3.12.0",
    "miniprogram-automator": "^0.12.1",
    "ts-jest": "^29.1.4",
    "typescript": "^5.4.5",
    "wx-server-sdk": "^4.0.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^wx-server-sdk$": "<rootDir>/node_modules/wx-server-sdk"
    }
  }
}
