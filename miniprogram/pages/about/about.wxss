.page-about {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 48rpx 48rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 页内返回（custom 导航无系统返回键；栈空兜底回首页） */
.nav-back {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 8rpx 0 24rpx;
  padding: 10rpx 22rpx 10rpx 16rpx;
  align-self: flex-start;
  border: 1rpx solid var(--rule);
  border-radius: 999rpx;
  background: var(--paper);
}
.nav-back-arrow {
  width: 14rpx;
  height: 14rpx;
  border-left: 3rpx solid var(--ink);
  border-bottom: 3rpx solid var(--ink);
  transform: rotate(45deg);
}
.nav-back-text {
  font-size: 24rpx;
  color: var(--ink-2);
}

.head {
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid var(--rule);
}
.title {
  font-family: var(--font-display);
  font-weight: 900;
  font-size: 44rpx;
}
.ver {
  display: block;
  margin-top: 10rpx;
  font-family: var(--font-mono);
  font-size: 21rpx;
  color: var(--ink-3);
}

.card { margin-top: 32rpx; }
.h {
  font-family: var(--font-display);
  font-weight: 900;
  font-size: 30rpx;
}
.p {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.9;
  color: var(--ink-2);
  white-space: pre-line;
}
