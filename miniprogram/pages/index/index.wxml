<view class="page-index" style="padding-top:{{navTop}}px">
  <!-- 品牌头 -->
  <view class="hero">
    <text class="eyebrow">PALM MORPHOLOGY · 掌纹形态图鉴</text>
    <view class="display">你的掌纹形态\n收进一本<text class="em">图鉴</text></view>
    <text class="lede">拍一张手掌照片，本机测量纹路形态——清晰度、密度、走向，十二形态型图鉴等你收集。照片不上传。</text>
  </view>

  <!-- 十二签宫格 plate -->
  <view class="plate">
    <view class="fig-row">
      <text class="figtag">MORPH SET — 十二掌纹形态型</text>
      <text class="fig-sub">每测一次解锁一型 · 免费不限次</text>
    </view>
    <view class="sign-grid">
      <view class="sign-cell" wx:for="{{signs}}" wx:key="no">
        <view class="cell-seal">{{item.seal}}</view>
        <text class="cell-no">{{item.no}}</text>
      </view>
    </view>
  </view>

  <!-- 底部操作区 -->
  <view class="foot">
    <!-- 快门式图标 CTA（呼应拍摄页）+ 中性文字副 CTA（3.2/3.3：明示功能，不藏） -->
    <view class="cta-icon" bindtap="goCapture" aria-label="拍照测量掌纹形态">
      <view class="cta-core" />
    </view>
    <text class="cta-text" bindtap="goCapture">拍照测形态 · 免费</text>
    <text class="draw-entry" bindtap="goDraw">随机抽人格签 · 纯随机娱乐 · 今日 {{remaining}} 次</text>
    <text class="buy-chip" wx:if="{{payEnabled && exhausted}}" bindtap="onTapBuy">次数不够用？¥1 加购 5 次</text>
    <view class="row-links">
      <text class="link" bindtap="goCollection">图鉴收集</text>
      <text class="sep">·</text>
      <text class="link" bindtap="goHistory">历史记录</text>
      <text class="sep">·</text>
      <text class="link" bindtap="goAbout">关于</text>
    </view>
    <text class="disclaimer">{{disclaimer}}</text>
  </view>
</view>
