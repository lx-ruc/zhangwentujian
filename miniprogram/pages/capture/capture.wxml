<view class="page-capture" style="padding-top:{{navTop}}px">
  <!-- 顶部导航 -->
  <view class="nav">
    <text class="back" bindtap="goBack">‹ 返回</text>
    <text class="title">今日留影</text>
    <text class="back ghost">‹ 返回</text>
  </view>

  <!-- 取景区：固定比例卡片居中（遮罩与轮廓严格对位） -->
  <view class="vf-wrap">
    <view class="viewfinder">
      <!-- 相机铺满取景卡（inset 展开写法，原生组件对简写支持不稳） -->
      <camera
        wx:if="{{!cameraBroken}}"
        class="camera"
        style="left: 0; right: 0; top: 0; bottom: 0;"
        device-position="{{cameraPos}}"
        flash="off"
        resolution="high"
        binderror="onCameraError"
      />

      <!-- 权限被拒占位 -->
      <view wx:if="{{cameraDenied}}" class="cam-placeholder">
        <text class="cam-tip">相机权限未开启</text>
        <button class="cam-setting-btn" bindtap="openSetting">去开启相机权限</button>
        <text class="cam-tip-sub">开启后返回本页即可实时取景</text>
      </view>

      <!-- 取景框：四角标 + 扫描线（无轮廓遮罩） -->
      <view class="corner tl" /><view class="corner tr" />
      <view class="corner bl" /><view class="corner br" />
      <view class="scan" wx:if="{{!cameraBroken}}" />
      <text class="vf-hint">{{hand === 'left' ? '左手' : '右手'}} · 五指自然张开，完整入镜</text>
    </view>
  </view>

  <!-- 左右手 -->
  <view class="hand-pick">
    <text class="pick {{hand === 'right' ? 'on' : ''}}" data-hand="right" bindtap="pickHand">右手 · 常用手</text>
    <text class="pick {{hand === 'left' ? 'on' : ''}}" data-hand="left" bindtap="pickHand">左手</text>
  </view>

  <!-- 快门：仅拍摄 -->
  <view class="shutter-row">
    <view class="shutter" bindtap="shoot" />
  </view>

  <text wx:if="{{privacyHint}}" class="privacy-hint">{{privacyHint}}</text>
</view>
