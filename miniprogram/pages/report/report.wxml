<view class="page-report">
  <!-- 头部：标题 + 评分印章 -->
  <view class="head">
    <view class="head-text">
      <text class="eyebrow">READING COMPLETE</text>
      <text class="title">解读完成</text>
      <text class="meta">{{handText}} · {{modelVersion}}</text>
    </view>
    <view class="score-seal">
      <text class="score">{{funScore}}</text>
      <text class="score-label">趣味评分</text>
    </view>
  </view>

  <!-- 总评 -->
  <view class="card summary">
    <text class="card-tag">总评 · SUMMARY</text>
    <text class="summary-text">{{summary}}</text>
  </view>

  <!-- 三大主线 -->
  <view class="card lines">
    <text class="card-tag">三大主线 · MAIN LINES</text>
    <view class="line-row" wx:for="{{lines}}" wx:key="key">
      <view class="line-head">
        <text class="line-name">{{item.name}}</text>
        <text class="line-desc">{{item.desc}}</text>
        <text class="line-score">{{item.score}}</text>
      </view>
      <view class="line-track"><view class="line-fill" style="width: {{item.score}}%" /></view>
    </view>
  </view>

  <!-- 四维速读 -->
  <view class="card dims">
    <text class="card-tag">四维速读 · PROFILE</text>
    <view class="dim-grid">
      <view class="dim" wx:for="{{dimensions}}" wx:key="key">
        <text class="dim-title">{{item.title}}<text class="dim-en"> {{item.en}}</text></text>
        <text class="dim-text">{{item.text}}</text>
      </view>
    </view>
  </view>

  <!-- 建议 -->
  <view class="card advice" wx:if="{{advice.length}}">
    <text class="card-tag">掌上锦囊 · ADVICE</text>
    <view class="advice-item" wx:for="{{advice}}" wx:key="index">
      <text class="idx">{{index + 1}}</text>
      <text class="advice-text">{{item}}</text>
    </view>
  </view>

  <!-- 操作 -->
  <view class="actions">
    <button class="cta" open-type="share" plain="{{false}}">分享给朋友 · 看看准不准</button>
    <view class="row-links">
      <text class="link" bindtap="goHistory">查看历史记录</text>
      <text class="sep">·</text>
      <text class="link" bindtap="goIndex">再来一次</text>
    </view>
  </view>

  <text class="disclaimer">{{disclaimer}}</text>
</view>
