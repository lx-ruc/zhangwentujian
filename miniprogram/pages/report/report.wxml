<view class="page-report" style="padding-top:{{navTop}}px">
  <!-- 头部：四行式人格签（四行均铺满内容宽，字号按文案长度反推） -->
  <view class="head">
    <text class="r-eyebrow">SIGN COLLECTION · 趣味人格测试</text>
    <view class="t1"><text class="t1-label">你的人格签是：</text><text class="t1-name" style="font-size:{{t1NameSize}}">{{palmType.name}}</text></view>
    <view class="t2" style="{{t2Style}}"><text class="t2-label">你的性格底稿：</text><text class="t2-text">{{palmType.tagline}}</text></view>
    <view class="t3" style="{{t3Style}}"><text class="t3-label">和你最合拍的人格签是：</text><text class="t3-text">{{palmType.compat[0]}}／{{palmType.compat[1]}}</text></view>
    <view class="type-pills">
      <text class="pill">人格属性·{{palmType.dominantLabel}}·{{palmType.styleLabel}}</text>
      <text class="pill rare">稀有度·{{palmType.rarity}} · 趣味估算</text>
      <view class="type-seal">{{palmType.seal}}</view>
    </view>
  </view>

  <!-- 签纸主视觉：大印章字 + 图鉴编号 + 朱砂界线（纯 wxml，无图片资产） -->
  <view class="sign-hero">
    <view class="sign-paper">
      <view class="sign-top">
        <text class="sign-no">{{palmType.no}} · AI掌纹分析</text>
        <text class="sign-code">{{palmType.code}}</text>
      </view>
      <view class="sign-body">
        <view class="seal-box"><text class="seal-char">{{palmType.seal}}</text></view>
        <view class="sign-info">
          <text class="sign-name">{{palmType.name}}</text>
          <view class="sign-rule" />
          <text class="sign-label">{{palmType.dominantLabel}} · {{palmType.styleLabel}}</text>
        </view>
      </view>
    </view>
    <!-- 三维特质条 -->
    <view class="line-bars">
      <view class="line-bar" wx:for="{{lines}}" wx:key="key">
        <text class="lb-name">{{item.name}}</text>
        <view class="lb-track"><view class="lb-fill" style="width:{{item.score}}%" /></view>
        <text class="lb-score">{{item.score}}</text>
      </view>
    </view>
  </view>

  <!-- 总评 -->
  <view class="card summary">
    <text class="card-tag">总评 · SUMMARY</text>
    <text class="summary-text">{{summary}}</text>
  </view>

  <!-- 四维速读 -->
  <view class="card dims">
    <text class="card-tag">四维速读 · PROFILE</text>
    <view class="dim-grid">
      <view class="dim" wx:for="{{dimensions}}" wx:key="key">
        <text class="dim-title">{{item.title}}<text class="dim-en"> {{item.en}}</text></text>
        <text class="dim-text">{{item.text}}</text>
      </view>
    </view>
  </view>

  <!-- 场景速读：工作 / 生活 / 身心 -->
  <view class="card scenes" wx:if="{{scenes.length}}">
    <text class="card-tag">场景速读 · IN PRACTICE</text>
    <view class="scene" wx:for="{{scenes}}" wx:key="key">
      <view class="scene-head">
        <text class="scene-icon">{{item.icon}}</text>
        <text class="scene-title">{{item.title}}<text class="scene-en"> {{item.en}}</text></text>
      </view>
      <view class="scene-body">
        <text class="scene-trait" wx:for="{{item.traits}}" wx:for-item="t" wx:key="*this">{{t}}</text>
        <text class="scene-caution" wx:for="{{item.cautions}}" wx:for-item="c" wx:key="*this">{{c}}</text>
      </view>
    </view>
  </view>

  <!-- 建议 -->
  <view class="card advice" wx:if="{{advice.length}}">
    <text class="card-tag">小锦囊 · ADVICE</text>
    <view class="advice-item" wx:for="{{advice}}" wx:key="index">
      <text class="idx">{{index + 1}}</text>
      <text class="advice-text">{{item}}</text>
    </view>
  </view>

  <!-- 操作 -->
  <view class="actions">
    <button class="cta" open-type="share" plain="{{false}}">分享给朋友 · 看看准不准</button>
    <button class="poster-btn" bindtap="openPoster">生成分享海报 · 发朋友圈</button>
    <view class="row-links">
      <text class="link" bindtap="goCollection">图鉴收集</text>
      <text class="sep">·</text>
      <text class="link" bindtap="goHistory">历史记录</text>
      <text class="sep">·</text>
      <text class="link" bindtap="goIndex">再来一次</text>
    </view>
  </view>

  <text class="disclaimer">{{disclaimer}}</text>

  <!-- 海报弹层 -->
  <view class="poster-mask" wx:if="{{showPoster}}" catchtap="closePoster">
    <view class="poster-sheet" catchtap="noop">
      <canvas type="2d" id="poster" class="poster-canvas {{posterReady ? '' : 'loading'}}" />
      <text wx:if="{{!posterReady}}" class="poster-tip">海报生成中…</text>
      <view class="poster-actions">
        <button class="save" bindtap="savePoster" disabled="{{!posterReady}}">保存到相册</button>
        <button class="close" catchtap="closePoster">关闭</button>
      </view>
    </view>
  </view>
</view>
