.page-report {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 48rpx 48rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  position: relative;
  overflow-x: hidden;
  width: 100%;
}

/* ===== 手掌主视觉：三线分数标注在线上 ===== */
.palm-hero {
  position: relative;
  width: 100%;
  margin-top: 24rpx;
  display: flex;
  justify-content: center;
}
.palm-box {
  position: relative;
  width: 560rpx;
  height: 588rpx;
}
.palm-img {
  width: 100%;
  height: 100%;
}
/* 右手：插画镜像（拇指右，与拍摄页遮罩同一直觉视角） */
.palm-img.mirror { transform: scaleX(-1); }
/* 图鉴式引线标注：dot 锚点 → leader 细线 → tag 标签（两侧留白不遮线） */
.mark { position: absolute; }
.dot {
  position: absolute;
  width: 12rpx; height: 12rpx;
  border-radius: 50%;
  background: var(--cinnabar);
  transform: translate(-50%, -50%);
}
.leader {
  position: absolute;
  height: 2rpx;
  background: var(--ink-3);
  transform-origin: 0 50%;
}
.tag {
  position: absolute;
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  white-space: nowrap;
  background: var(--paper);
  border: 1rpx solid var(--rule);
  border-radius: 8rpx;
  padding: 6rpx 16rpx;  /* 两侧留白 */
}
.tag-name {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: 24rpx;
  color: var(--ink);
}
.tag-score {
  font-family: var(--font-mono);
  font-weight: 700;
  font-size: 30rpx;
  color: var(--cinnabar);
}
/* 三条线几何：水平引线（与首页 PLATE Ⅰ 同语言），标签边缘精确贴线端，y 错开不叠 */
/* 情感线：向左引出（y 50.2%） */
.mk-heart { left: 62.6%; top: 50.2%; }
.mk-heart .leader { width: 230rpx; left: -230rpx; top: 0; transform: translateY(-50%); }
.mk-heart .tag { left: -230rpx; top: 0; transform: translate(-100%, -50%); }
/* 思维线：向右引出（y 56.5%，与情感线分居两侧） */
.mk-head { left: 60.2%; top: 56.5%; }
.mk-head .leader { width: 120rpx; height: 2rpx; left: 0; top: 0; transform: translateY(-50%); }
.mk-head .tag { left: 116rpx; top: 6rpx; transform: translateY(-50%); }
/* 活力线：向左下引出（y 65.4%，与情感线同侧但相隔 15% 高度） */
.mk-life { left: 55.2%; top: 65.4%; }
.mk-life .leader { width: 210rpx; left: -210rpx; top: 0; transform: translateY(-50%); }
.mk-life .tag { left: -175rpx; top: 0; transform: translate(-100%, -50%); }
/* ===== 右手版标注几何（镜像后线位 x→100-x，引线方向反转） ===== */
.right-hand .mk-heart { left: 37.4%; top: 50.2%; }
.right-hand .mk-heart .leader { width: 236rpx; transform: rotate(-23.8deg); }
.right-hand .mk-heart .tag { left: 216rpx; top: -95rpx; transform: translate(0, -50%); }
.right-hand .mk-head { left: 39.8%; top: 56.5%; }
.right-hand .mk-head .leader { width: 145rpx; transform: rotate(177.7deg); }
.right-hand .mk-head .tag { left: -144rpx; top: 6rpx; transform: translate(-100%, -50%); }
.right-hand .mk-life { left: 44.8%; top: 65.4%; }
.right-hand .mk-life .leader { width: 208rpx; transform: rotate(0deg); }
.right-hand .mk-life .tag { left: 208rpx; top: 0; transform: translateY(-50%); }
