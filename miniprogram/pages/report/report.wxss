/* ===== 页面容器（重构时曾被误删，恢复：56rpx 左右留白 + 禁横滚；padding-top 由 navTop 内联提供） ===== */
.page-report {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 0 56rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  position: relative;
  overflow-x: hidden;
  width: 100%;
}

/* ===== 头部（四行式样式见文末「头部四行式」） ===== */
/* ===== 签纸主视觉：大印章字 + 图鉴编号 + 朱砂界线（纯 wxml/wxss） ===== */
.sign-hero {
  margin-top: 24rpx;
}
.sign-paper {
  background: var(--paper);
  border: 2rpx solid var(--rule);
  border-radius: 16rpx;
  padding: 24rpx 32rpx 32rpx;
  box-sizing: border-box;
}
.sign-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 18rpx;
  border-bottom: 1rpx dashed var(--rule);
}
.sign-no {
  font-family: var(--font-mono);
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: var(--ink-2);
}
.sign-code {
  font-family: var(--font-mono);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: var(--cinnabar);
  border: 2rpx solid var(--cinnabar);
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
  transform: rotate(-4deg);
}
.sign-body {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  gap: 40rpx;
}
.seal-box {
  flex-shrink: 0;
  width: 200rpx;
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 5rpx solid var(--cinnabar);
  border-radius: 20rpx;
  transform: rotate(-5deg);
  box-shadow: inset 0 0 0 3rpx rgba(188, 63, 33, 0.2);
  background: rgba(188, 63, 33, 0.04);
}
.seal-char {
  font-family: var(--font-display);
  font-weight: 900;
  font-size: 116rpx;
  color: var(--cinnabar);
  line-height: 1;
}
.sign-info {
  flex: 1;
  min-width: 0;
}
.sign-name {
  display: block;
  font-family: var(--font-display);
  font-weight: 900;
  font-size: 56rpx;
  line-height: 1.3;
}
.sign-rule {
  margin: 18rpx 0;
  height: 3rpx;
  background: linear-gradient(90deg, var(--cinnabar), rgba(188, 63, 33, 0.08));
  border-radius: 2rpx;
}
.sign-label {
  display: block;
  font-size: 26rpx;
  letter-spacing: 4rpx;
  color: var(--ink-2);
}

/* 三维特质条 */
.line-bars {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.line-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.lb-name {
  flex-shrink: 0;
  width: 132rpx;
  font-family: var(--font-display);
  font-weight: 700;
  font-size: 27rpx;
}
.lb-track {
  flex: 1;
  height: 16rpx;
  background: var(--paper-2);
  border-radius: 8rpx;
  overflow: hidden;
}
.lb-fill {
  height: 100%;
  background: var(--cinnabar);
  border-radius: 8rpx;
}
.lb-score {
  flex-shrink: 0;
  width: 64rpx;
  text-align: right;
  font-family: var(--font-mono);
  font-weight: 700;
  font-size: 28rpx;
  color: var(--cinnabar);
}
/* ===== 卡片通用 ===== */
.card {
  margin-top: 32rpx;
  background: var(--paper);
  border: 1rpx solid var(--rule);
  border-radius: 16rpx;
  padding: 32rpx 36rpx;
}
.card-tag {
  font-family: var(--font-mono);
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: var(--ink-2);
}

/* 总评 */
.summary-text {
  display: block;
  margin-top: 20rpx;
  font-size: 28rpx;
  line-height: 1.9;
}

/* 四维 */
.dim-grid {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}
.dim {
  background: var(--paper-2);
  border-radius: 12rpx;
  padding: 24rpx;
}
.dim-title {
  font-family: var(--font-display);
  font-weight: 900;
  font-size: 30rpx;
}
.dim-en {
  font-family: var(--font-mono);
  font-size: 18rpx;
  color: var(--ink-3);
  font-weight: 400;
}
.dim-text {
  display: block;
  margin-top: 14rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: var(--ink-2);
}

/* 头部人格称号 */
.archetype {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--cinnabar);
  font-family: var(--font-display);
  font-weight: 600;
}

/* 图鉴类型徽章 */

/* 场景速读 */
.scene { margin-top: 26rpx; }
.scene-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.scene-icon {
  width: 52rpx; height: 52rpx;
  display: flex; align-items: center; justify-content: center;
  border: 2rpx solid var(--cinnabar);
  border-radius: 8rpx;
  color: var(--cinnabar);
  font-family: var(--font-display);
  font-weight: 900;
  font-size: 28rpx;
  transform: rotate(-6deg);
}
.scene-title {
  font-family: var(--font-display);
  font-weight: 900;
  font-size: 30rpx;
}
.scene-en {
  font-family: var(--font-mono);
  font-size: 18rpx;
  color: var(--ink-3);
  font-weight: 400;
}
.scene-body {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.scene-trait {
  font-size: 25rpx;
  line-height: 1.7;
  padding-left: 20rpx;
  border-left: 4rpx solid var(--rule);
}
.scene-caution {
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--ink-2);
  background: var(--paper-2);
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
}

/* 建议 */
.advice-item {
  margin-top: 20rpx;
  display: flex;
  gap: 16rpx;
  align-items: baseline;
}
.idx {
  font-family: var(--font-mono);
  font-size: 24rpx;
  color: var(--cinnabar);
  font-weight: 700;
}
.advice-text { flex: 1; font-size: 26rpx; line-height: 1.7; }

/* 操作 */
.actions { margin-top: 44rpx; }
/* 分享主按钮：文字较长，缩字号保单行不换行 */
.actions .cta {
  font-size: 27rpx;
  padding: 24rpx 12rpx;
  white-space: nowrap;
  overflow: hidden;
}
.poster-btn {
  margin-top: 20rpx;
  background: var(--paper);
  color: var(--ink);
  border: 2rpx solid var(--ink);
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 22rpx 0;
  line-height: 1.5;
}
.poster-btn::after { border: none; }
.poster-btn:active { background: var(--paper-2); }

/* 海报弹层 */
.poster-mask {
  position: fixed;
  inset: 0;
  background: rgba(38, 33, 26, 0.72);
  z-index: 99;
  display: flex;
  align-items: center;
  justify-content: center;
}
.poster-sheet {
  position: relative;
  width: 500rpx;
  background: var(--paper);
  border-radius: 20rpx;
  padding: 20rpx 20rpx 0;
}
.poster-canvas {
  width: 460rpx;
  height: 736rpx;
  border-radius: 12rpx;
}
.poster-canvas.loading { opacity: 0.4; }
.poster-tip {
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--ink-2);
  transform: translateY(-50%);
}
.poster-actions {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 0 24rpx;
}
.poster-actions button {
  flex: 1;
  font-size: 28rpx;
  border-radius: 10rpx;
  padding: 16rpx 0;
  line-height: 1.5;
}
.poster-actions .save {
  background: var(--cinnabar);
  color: var(--paper);
}
.poster-actions .save::after { border: none; }
.poster-actions .save[disabled] { background: var(--ink-3); color: var(--paper); }
.poster-actions .close {
  background: var(--paper-2);
  color: var(--ink-2);
}
.poster-actions .close::after { border: none; }
.row-links {
  margin-top: 24rpx;
  display: flex;
  justify-content: center;
  gap: 20rpx;
  font-size: 26rpx;
  color: var(--ink-2);
}
.link { padding: 8rpx 12rpx; }
.sep { color: var(--rule); }

/* ===== 头部四行式（四行横向铺满：两端锚定 + 点线填充 + 胶囊铺满） ===== */
.head {
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid var(--rule);
}

/* 行1：label 左 · 类型名右（基线对齐，无空隙） */
.t1 {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  font-family: var(--font-display);
  font-weight: 700;
  line-height: 1.4;
}
.t1-label {
  flex-shrink: 0;
  font-size: 44rpx;
}
.t1-name {
  flex-shrink: 0;
  font-weight: 900;
  color: var(--cinnabar);
  /* 字号由 headFontSizes 按文案长度反推（内联样式），不加 letter-spacing 以免破坏铺满精度 */
}

/* 行2/3：连续整行文字（两行共用字号，内联反推铺满；短行由字间距补满） */
.t2, .t3 {
  margin-top: 16rpx;
  line-height: 1.4;
}
.t2-label, .t3-label {
  font-family: var(--font-display);
  color: var(--ink-2);
}
.t2-text {
  font-family: var(--font-display);
  font-weight: 600;
  color: var(--ink);
}
.t3-text {
  font-family: var(--font-display);
  font-weight: 700;
  color: var(--ink);
}

/* 行4：胶囊组横向铺满整行（flex 拉伸 + 固定高度居中文字） */
.type-pills {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
}
.pill {
  flex: 1.15;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  line-height: 1;
  border: 1rpx solid var(--rule);
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--ink-2);
  background: var(--paper);
}
.pill.rare {
  flex: 1;
  border-color: var(--cinnabar);
  color: var(--cinnabar);
}
/* 人格签印章：类型名代表字（燎原星火→燎），行尾方章 */
.type-seal {
  flex-shrink: 0;
  width: 56rpx; height: 56rpx;
  display: flex; align-items: center; justify-content: center;
  border: 3rpx solid var(--cinnabar);
  border-radius: 8rpx;
  color: var(--cinnabar);
  font-family: var(--font-display);
  font-weight: 900;
  font-size: 30rpx;
  transform: rotate(-6deg);
  box-shadow: inset 0 0 0 2rpx rgba(188, 63, 33, 0.2);
  background: rgba(188, 63, 33, 0.04);
}

/* 双语 eyebrow（第一行上方小字） */
.r-eyebrow {
  display: block;
  font-family: var(--font-mono);
  font-size: 20rpx;
  letter-spacing: 3rpx;
  color: var(--ink-2);
  margin-bottom: 8rpx;
}
