.page-report {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 48rpx 48rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ===== 头部 ===== */
.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 32rpx;
  border-bottom: 1rpx solid var(--rule);
}
.eyebrow {
  font-family: var(--font-mono);
  font-size: 20rpx;
  letter-spacing: 3rpx;
  color: var(--ink-2);
}
.title {
  display: block;
  margin-top: 8rpx;
  font-family: var(--font-display);
  font-weight: 900;
  font-size: 48rpx;
}
.meta {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}
.score-seal {
  width: 168rpx; height: 168rpx;
  border: 5rpx solid var(--cinnabar);
  border-radius: 20rpx;
  transform: rotate(-6deg);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 0 0 3rpx rgba(188, 63, 33, 0.2);
  background: rgba(188, 63, 33, 0.04);
}
.score {
  font-family: var(--font-display);
  font-weight: 900;
  font-size: 72rpx;
  line-height: 1;
  color: var(--cinnabar);
}
.score-label {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--cinnabar);
  letter-spacing: 2rpx;
}

/* ===== 卡片通用 ===== */
.card {
  margin-top: 32rpx;
  background: var(--paper);
  border: 1rpx solid var(--rule);
  border-radius: 16rpx;
  padding: 32rpx 36rpx;
}
.card-tag {
  font-family: var(--font-mono);
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: var(--ink-2);
}

/* 总评 */
.summary-text {
  display: block;
  margin-top: 20rpx;
  font-size: 28rpx;
  line-height: 1.9;
}

/* 三大主线 */
.lines .line-row { margin-top: 28rpx; }
.line-row:first-of-type { margin-top: 20rpx; }
.line-head {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}
.line-name {
  font-family: var(--font-display);
  font-weight: 900;
  font-size: 30rpx;
}
.line-desc { flex: 1; font-size: 22rpx; color: var(--ink-3); }
.line-score {
  font-family: var(--font-mono);
  font-size: 28rpx;
  color: var(--cinnabar);
  font-weight: 700;
}
.line-track {
  margin-top: 12rpx;
  height: 10rpx;
  background: var(--paper-2);
  border-radius: 5rpx;
  overflow: hidden;
}
.line-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--cinnabar-deep), var(--cinnabar));
  border-radius: 5rpx;
  transition: width 0.8s ease-out;
}

/* 四维 */
.dim-grid {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}
.dim {
  background: var(--paper-2);
  border-radius: 12rpx;
  padding: 24rpx;
}
.dim-title {
  font-family: var(--font-display);
  font-weight: 900;
  font-size: 30rpx;
}
.dim-en {
  font-family: var(--font-mono);
  font-size: 18rpx;
  color: var(--ink-3);
  font-weight: 400;
}
.dim-text {
  display: block;
  margin-top: 14rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: var(--ink-2);
}

/* 建议 */
.advice-item {
  margin-top: 20rpx;
  display: flex;
  gap: 16rpx;
  align-items: baseline;
}
.idx {
  font-family: var(--font-mono);
  font-size: 24rpx;
  color: var(--cinnabar);
  font-weight: 700;
}
.advice-text { flex: 1; font-size: 26rpx; line-height: 1.7; }

/* 操作 */
.actions { margin-top: 44rpx; }
.row-links {
  margin-top: 24rpx;
  display: flex;
  justify-content: center;
  gap: 20rpx;
  font-size: 26rpx;
  color: var(--ink-2);
}
.link { padding: 8rpx 12rpx; }
.sep { color: var(--rule); }
