/* ===== 页面容器（重构时曾被误删，恢复：56rpx 左右留白 + 禁横滚；padding-top 由 navTop 内联提供） ===== */
.page-report {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 0 56rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  position: relative;
  overflow-x: hidden;
  width: 100%;
}

/* ===== 兜底横幅（提醒级：墨底 + 朱砂细节，非错误级） ===== */
.fallback-banner {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
  padding: 24rpx 28rpx;
  background: var(--paper);
  border: 1rpx solid var(--rule);
  border-left: 6rpx solid var(--cinnabar);
  border-radius: 12rpx;
}
.fallback-copy {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.fallback-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink);
}
.fallback-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}
.fallback-btn {
  flex-shrink: 0;
  padding: 14rpx 28rpx;
  font-size: 24rpx;
  color: #fff;
  background: var(--cinnabar);
  border-radius: 999rpx;
}

/* ===== 头部 ===== */
.head {
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid var(--rule);
}
/* 行1：文字块自适应 + 印章紧随（22rpx 间隙）；长文案下沉全宽行 */
.head-row1 .head-text { flex: none; }

.head-text {
  flex: none;
  min-width: 0;
}
/* ===== 手掌主视觉：三线分数标注在线上 ===== */
.palm-hero {
  position: relative;
  width: 100%;
  margin-top: 24rpx;
  display: flex;
  justify-content: center;
}
.palm-box {
  position: relative;
  width: 560rpx;
  height: 588rpx;
}
.palm-img {
  width: 100%;
  height: 100%;
}
/* 右手：插画镜像（拇指右，与拍摄页遮罩同一直觉视角） */
.palm-img.mirror { transform: scaleX(-1); }
/* 图鉴式引线标注：dot 锚点 → leader 细线 → tag 标签（两侧留白不遮线） */
.mark { position: absolute; }
.dot {
  position: absolute;
  width: 12rpx; height: 12rpx;
  border-radius: 50%;
  background: var(--cinnabar);
  transform: translate(-50%, -50%);
}
.leader {
  position: absolute;
  height: 2rpx;
  background: var(--ink-3);
  transform-origin: 0 50%;
}
.tag {
  position: absolute;
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  white-space: nowrap;
  background: var(--paper);
  border: 1rpx solid var(--rule);
  border-radius: 8rpx;
  padding: 6rpx 16rpx;  /* 两侧留白 */
}
.tag-name {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: 24rpx;
  color: var(--ink);
}
.tag-score {
  font-family: var(--font-mono);
  font-weight: 700;
  font-size: 30rpx;
  color: var(--cinnabar);
}
/* 三条线几何：水平引线（与首页 PLATE Ⅰ 同语言），标签边缘精确贴线端，y 错开不叠 */
/* 情感线：向左引出（y 50.2%） */
.mk-heart { left: 62.6%; top: 50.2%; }
.mk-heart .leader { width: 228rpx; transform: rotate(198.4deg); }
.mk-heart .tag { left: -216rpx; top: -72rpx; transform: translate(-100%, -50%); }
/* 思维线：向右引出（y 56.5%，与情感线分居两侧） */
.mk-head { left: 60.2%; top: 56.5%; }
.mk-head .leader { width: 117rpx; transform: rotate(2.9deg); }
.mk-head .tag { left: 116rpx; top: 6rpx; transform: translateY(-50%); }
/* 活力线：向左下引出（y 65.4%，与情感线同侧但相隔 15% 高度） */
.mk-life { left: 55.2%; top: 65.4%; }
.mk-life .leader { width: 175rpx; transform: rotate(180deg); }
.mk-life .tag { left: -175rpx; top: 0; transform: translate(-100%, -50%); }
/* ===== 右手版标注几何（镜像后线位 x→100-x，引线方向反转） ===== */
.right-hand .mk-heart { left: 37.4%; top: 50.2%; }
.right-hand .mk-heart .leader { width: 236rpx; transform: rotate(-23.8deg); }
.right-hand .mk-heart .tag { left: 216rpx; top: -95rpx; transform: translate(0, -50%); }
.right-hand .mk-head { left: 39.8%; top: 56.5%; }
.right-hand .mk-head .leader { width: 128rpx; transform: rotate(177.4deg); }
.right-hand .mk-head .tag { left: -128rpx; top: 6rpx; transform: translate(-100%, -50%); }
.right-hand .mk-life { left: 44.8%; top: 65.4%; }
.right-hand .mk-life .leader { width: 208rpx; transform: rotate(0deg); }
.right-hand .mk-life .tag { left: 208rpx; top: 0; transform: translateY(-50%); }
/* ===== 卡片通用 ===== */
.card {
  margin-top: 32rpx;
  background: var(--paper);
  border: 1rpx solid var(--rule);
  border-radius: 16rpx;
  padding: 32rpx 36rpx;
}
.card-tag {
  font-family: var(--font-mono);
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: var(--ink-2);
}

/* 总评 */
.summary-text {
  display: block;
  margin-top: 20rpx;
  font-size: 28rpx;
  line-height: 1.9;
}

/* 四维 */
.dim-grid {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}
.dim {
  background: var(--paper-2);
  border-radius: 12rpx;
  padding: 24rpx;
}
.dim-title {
  font-family: var(--font-display);
  font-weight: 900;
  font-size: 30rpx;
}
.dim-en {
  font-family: var(--font-mono);
  font-size: 18rpx;
  color: var(--ink-3);
  font-weight: 400;
}
.dim-text {
  display: block;
  margin-top: 14rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: var(--ink-2);
}

/* 头部人格称号 */
.archetype {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--cinnabar);
  font-family: var(--font-display);
  font-weight: 600;
}

/* 图鉴类型徽章 */

/* 场景速读 */
.scene { margin-top: 26rpx; }
.scene-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.scene-icon {
  width: 52rpx; height: 52rpx;
  display: flex; align-items: center; justify-content: center;
  border: 2rpx solid var(--cinnabar);
  border-radius: 8rpx;
  color: var(--cinnabar);
  font-family: var(--font-display);
  font-weight: 900;
  font-size: 28rpx;
  transform: rotate(-6deg);
}
.scene-title {
  font-family: var(--font-display);
  font-weight: 900;
  font-size: 30rpx;
}
.scene-en {
  font-family: var(--font-mono);
  font-size: 18rpx;
  color: var(--ink-3);
  font-weight: 400;
}
.scene-body {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.scene-trait {
  font-size: 25rpx;
  line-height: 1.7;
  padding-left: 20rpx;
  border-left: 4rpx solid var(--rule);
}
.scene-caution {
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--ink-2);
  background: var(--paper-2);
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
}

/* 建议 */
.advice-item {
  margin-top: 20rpx;
  display: flex;
  gap: 16rpx;
  align-items: baseline;
}
.idx {
  font-family: var(--font-mono);
  font-size: 24rpx;
  color: var(--cinnabar);
  font-weight: 700;
}
.advice-text { flex: 1; font-size: 26rpx; line-height: 1.7; }

/* 操作 */
.actions { margin-top: 44rpx; }
/* 分享主按钮：文字较长，缩字号保单行不换行 */
.actions .cta {
  font-size: 27rpx;
  padding: 24rpx 12rpx;
  white-space: nowrap;
  overflow: hidden;
}
.poster-btn {
  margin-top: 20rpx;
  background: var(--paper);
  color: var(--ink);
  border: 2rpx solid var(--ink);
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 22rpx 0;
  line-height: 1.5;
}
.poster-btn::after { border: none; }
.poster-btn:active { background: var(--paper-2); }

/* 海报弹层 */
.poster-mask {
  position: fixed;
  inset: 0;
  background: rgba(38, 33, 26, 0.72);
  z-index: 99;
  display: flex;
  align-items: center;
  justify-content: center;
}
.poster-sheet {
  position: relative;
  width: 500rpx;
  background: var(--paper);
  border-radius: 20rpx;
  padding: 20rpx 20rpx 0;
}
.poster-canvas {
  width: 460rpx;
  height: 736rpx;
  border-radius: 12rpx;
}
.poster-canvas.loading { opacity: 0.4; }
.poster-tip {
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--ink-2);
  transform: translateY(-50%);
}
.poster-actions {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 0 24rpx;
}
.poster-actions button {
  flex: 1;
  font-size: 28rpx;
  border-radius: 10rpx;
  padding: 16rpx 0;
  line-height: 1.5;
}
.poster-actions .save {
  background: var(--cinnabar);
  color: var(--paper);
}
.poster-actions .save::after { border: none; }
.poster-actions .save[disabled] { background: var(--ink-3); color: var(--paper); }
.poster-actions .close {
  background: var(--paper-2);
  color: var(--ink-2);
}
.poster-actions .close::after { border: none; }
.row-links {
  margin-top: 24rpx;
  display: flex;
  justify-content: center;
  gap: 20rpx;
  font-size: 26rpx;
  color: var(--ink-2);
}
.link { padding: 8rpx 12rpx; }
.sep { color: var(--rule); }

/* ===== 头部占满布局（评分印章已移除，分数嵌 eyebrow 行右端） ===== */
/* 属性徽章组：占满一行 */
.type-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}
.pill {
  padding: 6rpx 20rpx;
  border: 1rpx solid var(--rule);
  border-radius: 999rpx;
  font-size: 22rpx;
  color: var(--ink-2);
  background: var(--paper);
}
.pill.rare {
  border-color: var(--cinnabar);
  color: var(--cinnabar);
}

/* ===== 头部四行式（仅四行） ===== */
.head { padding-bottom: 28rpx; border-bottom: 1rpx solid var(--rule); }
.t1 {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: 40rpx;
  line-height: 1.4;
}
.t1-name {
  font-weight: 900;
  font-size: 56rpx;
  color: var(--cinnabar);
}
.t2, .t3 {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--ink-2);
}
.t2-text {
  font-family: var(--font-display);
  color: var(--ink);
}
.t3-text {
  font-family: var(--font-display);
  font-weight: 700;
  color: var(--ink);
}
.type-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}
.pill {
  padding: 8rpx 22rpx;
  border: 1rpx solid var(--rule);
  border-radius: 999rpx;
  font-size: 22rpx;
  color: var(--ink-2);
  background: var(--paper);
}
.pill.rare {
  border-color: var(--cinnabar);
  color: var(--cinnabar);
}
