.page-analyzing {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 56rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ===== 头部 ===== */
.head { text-align: center; }
.title {
  font-family: var(--font-display);
  font-weight: 900;
  font-size: 44rpx;
  letter-spacing: 4rpx;
}
.eta {
  display: block;
  margin-top: 10rpx;
  font-family: var(--font-mono);
  font-size: 20rpx;
  letter-spacing: 3rpx;
  color: var(--ink-2);
}
.progress {
  margin-top: 28rpx;
  width: 100%;
  height: 6rpx;
  background: var(--paper-2);
  border-radius: 3rpx;
  overflow: hidden;
}
.bar {
  height: 100%;
  background: var(--cinnabar);
  border-radius: 3rpx;
  transition: width 0.4s linear;
}

/* ===== 手掌 ===== */
.plate { margin-top: 36rpx; }
.hand {
  width: 380rpx;
  height: 400rpx;
  animation: breathe 2.2s ease-in-out infinite;
}
.hand.settled { animation: none; }

/* 用户手掌照片（扫描中） */
.photo-wrap {
  position: relative;
  width: 340rpx;
  height: 400rpx;
  border-radius: 20rpx;
  overflow: hidden;
  border: 2rpx solid var(--rule);
}
.photo { width: 100%; height: 100%; }
.photo-scan {
  position: absolute;
  left: 0; right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, transparent, var(--cinnabar), transparent);
  animation: photoscan 2.4s ease-in-out infinite;
}
@keyframes photoscan {
  0% { top: 8%; opacity: 0; }
  15% { opacity: 1; }
  85% { opacity: 1; }
  100% { top: 92%; opacity: 0; }
}
.photo-tag {
  position: absolute;
  bottom: 12rpx;
  left: 0; right: 0;
  text-align: center;
  color: var(--paper);
  font-size: 20rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.6);
}
@keyframes breathe {
  0%, 100% { transform: scale(1); opacity: 0.92; }
  50% { transform: scale(1.03); opacity: 1; }
}

/* ===== 趣味知识 ===== */
.fact-card {
  margin-top: 44rpx;
  width: 100%;
  background: var(--paper-2);
  border: 1rpx solid var(--rule);
  border-radius: 16rpx;
  padding: 32rpx 36rpx;
  box-sizing: border-box;
}
.fact-tag {
  font-family: var(--font-mono);
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: var(--cinnabar);
}
.fact-text {
  display: block;
  margin-top: 16rpx;
  min-height: 120rpx;
  font-size: 27rpx;
  line-height: 1.8;
  color: var(--ink);
}
.dots {
  margin-top: 20rpx;
  display: flex;
  justify-content: center;
  gap: 12rpx;
}
.dot {
  width: 10rpx; height: 10rpx;
  border-radius: 50%;
  background: var(--ink-3);
  opacity: 0.4;
}
.dot.on { background: var(--cinnabar); opacity: 1; }
