<view class="page-analyzing" style="padding-top:{{navTop}}px">
  <!-- 头部 -->
  <view class="head">
    <text class="title">{{mode === 'morph' ? '正在测量' : '正在抽签'}}</text>
    <text class="eta">{{mode === 'morph' ? 'MEASURING · 本机进行' : 'DRAWING · 约 3 秒'}}</text>
  </view>
  <view class="progress"><view class="bar" style="width: {{progress}}%" /></view>

  <!-- 留影 plate：用户照片优先（扫描中），无图退回签纸卡（呼吸动画） -->
  <view class="plate">
    <block wx:if="{{handImage}}">
      <view class="photo-wrap">
        <image class="photo" src="{{handImage}}" mode="aspectFill" />
        <view class="photo-scan" />
        <text class="photo-tag">{{handText}} · {{mode === 'morph' ? '测量中' : '抽签中'}}</text>
      </view>
    </block>
    <view wx:else class="sign-card {{done ? 'settled' : ''}}">
      <text class="sign-seal">签</text>
    </view>
  </view>

  <!-- 签语轮播 -->
  <view class="fact-card">
    <text class="fact-tag">{{mode === 'morph' ? '测中须知' : '签中小议'}} · {{factIndex + 1}}/{{facts.length}}</text>
    <text class="fact-text">{{facts[factIndex]}}</text>
    <view class="dots">
      <view
        wx:for="{{facts}}"
        wx:key="index"
        class="dot {{index === factIndex ? 'on' : ''}}"
      />
    </view>
  </view>

  <text class="disclaimer">照片只保存在本机，不会上传；仅保留文字结果</text>

  <!-- 本机测量画布（不可见） -->
  <canvas type="2d" id="measure" class="measure-canvas" />
</view>
