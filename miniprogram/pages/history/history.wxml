<view class="page-history" style="padding-top:{{navTop}}px">
  <view class="head">
    <text class="title">测试记录</text>
    <text class="privacy-chip">仅答题 · 仅存文字</text>
  </view>

  <block wx:if="{{records.length}}">
    <view class="record card" wx:for="{{records}}" wx:key="id" bindtap="openRecord" data-id="{{item.id}}">
      <view class="record-head">
        <text class="date">{{item.date}}</text>
        <text class="hand">{{item.hand}}</text>
        <view class="mini-seal">{{item.score}}</view>
      </view>
      <text class="digest">{{item.digest}}</text>
      <view class="tags">
        <text class="tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
      </view>
    </view>
  </block>

  <view wx:else class="empty">
    <view class="empty-sign"><text class="empty-seal-char">？</text></view>
    <text>还没有测试记录</text>
    <text class="empty-sub">几道掌纹问答，匹配你的第一支人格签</text>
    <button class="cta" bindtap="goQuiz">去答题</button>
  </view>

  <text class="disclaimer">{{disclaimer}}</text>
</view>
