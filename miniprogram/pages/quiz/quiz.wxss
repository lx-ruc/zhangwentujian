/* 掌纹问答页 —— 宣纸/墨/朱砂；选项卡手掌图（canvas），选中朱砂标红 */
.page-quiz {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 32rpx 48rpx;
  background: var(--paper);
  display: flex;
  flex-direction: column;
}

/* ===== 进度头 ===== */
.quiz-head {
  padding: 24rpx 16rpx 8rpx;
}
.q-eyebrow {
  font-family: var(--font-mono);
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: var(--ink-2);
}
.q-progress {
  margin-top: 20rpx;
  height: 6rpx;
  background: var(--rule);
  border-radius: 3rpx;
  overflow: hidden;
}
.q-progress-bar {
  height: 100%;
  background: var(--cinnabar);
  transition: width 0.25s ease;
}
.q-step {
  display: block;
  margin-top: 12rpx;
  font-family: var(--font-mono);
  font-size: 20rpx;
  color: var(--ink-3);
  text-align: right;
}

/* ===== 题卡 ===== */
.q-card {
  margin-top: 20rpx;
  padding: 36rpx 28rpx 28rpx;
  background: var(--paper-2);
  border: 1rpx solid var(--rule);
  border-radius: 8rpx;
}
.q-title {
  display: block;
  font-family: var(--font-display);
  font-size: 40rpx;
  font-weight: 600;
  color: var(--ink);
}
.q-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--ink-2);
}
.q-note {
  display: block;
  margin-top: 20rpx;
  font-size: 20rpx;
  color: var(--ink-3);
  text-align: center;
}

/* ===== 选项卡（2 列网格） ===== */
.q-options {
  margin-top: 28rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}
.opt {
  padding: 16rpx 16rpx 14rpx;
  background: var(--paper);
  border: 2rpx solid var(--rule);
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: border-color 0.15s ease;
}
.opt.selected {
  border-color: var(--cinnabar);
}
.opt-canvas {
  width: 100%;
  height: 380rpx;
}
.opt-label {
  margin-top: 10rpx;
  font-family: var(--font-display);
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}
.opt.selected .opt-label {
  color: var(--cinnabar);
}
.opt-hint {
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 1.5;
  color: var(--ink-3);
  text-align: center;
}

/* ===== 底部导航 ===== */
.q-foot {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.q-spacer { flex: 1; }
.q-nav {
  padding: 20rpx 44rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  text-align: center;
}
.q-nav.prev {
  color: var(--ink-2);
  border: 1rpx solid var(--rule);
}
.q-nav.next {
  flex: 1;
  color: var(--paper);
  background: var(--ink);
  font-family: var(--font-display);
  font-weight: 600;
}
.q-nav.next.disabled {
  opacity: 0.35;
}

/* ===== 匹配中遮罩 ===== */
.q-mask {
  position: fixed;
  inset: 0;
  background: rgba(38, 33, 26, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}
.q-mask-box {
  padding: 48rpx 64rpx;
  background: var(--paper);
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.q-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 5rpx solid var(--rule);
  border-top-color: var(--cinnabar);
  border-radius: 50%;
  animation: q-spin 0.9s linear infinite;
}
@keyframes q-spin {
  to { transform: rotate(360deg); }
}
.q-mask-text {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: var(--ink);
}
